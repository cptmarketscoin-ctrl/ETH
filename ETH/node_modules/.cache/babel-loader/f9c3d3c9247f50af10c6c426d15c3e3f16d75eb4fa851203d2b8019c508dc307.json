{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  name: 'App',\n  data: function data() {\n    return {\n      active: 0,\n      tabs: [{\n        name: 'Home',\n        path: '/',\n        icon: 'iconfont icon-a-home1'\n      }, {\n        name: 'Market',\n        path: '/market',\n        icon: 'iconfont icon-hangqing'\n      }, {\n        name: 'Trade',\n        path: '/trade',\n        icon: 'iconfont icon-Market'\n      }, {\n        name: 'Earn',\n        path: '/earn',\n        icon: 'iconfont icon-Market'\n      }, {\n        name: 'Assets',\n        path: '/assets',\n        icon: 'iconfont icon-business'\n      }]\n    };\n  },\n  methods: {\n    go: function go(i, p) {\n      this.active = i;\n      this.$router.push(p);\n    }\n  },\n  watch: {\n    '$route': function $route(to) {\n      var m = {\n        '/': 0,\n        '/market': 1,\n        '/trade': 2,\n        '/earn': 3,\n        '/assets': 4\n      };\n      this.active = m[to.path] != null ? m[to.path] : this.active;\n    }\n  }\n};","map":{"version":3,"names":["name","data","active","tabs","path","icon","methods","go","i","p","$router","push","watch","$route","to","m"],"sources":["src/App.vue"],"sourcesContent":["<template>\n<div class=\"layout\">\n  <div class=\"header-container is-fixed is-small w-full flex justify-center max-h is-scrolly\">\n    <header id=\"header_main\" class=\"header max-h\">\n      <div class=\"container-fluid max-h w-100\">\n        <div class=\"header__body d-flex justify-content-between max-h\">\n          <div class=\"header__left\"><div class=\"logo\"><span class=\"logo-text\">CPT Exchange</span></div></div>\n          <div class=\"header__right\">\n            <div class=\"mobile-connect\" @click=\"$router.push('/earn')\"><span>Connect</span></div>\n          </div>\n        </div>\n      </div>\n    </header>\n  </div>\n  <div class=\"h-50px\" style=\"height:50px\"></div>\n  <div class=\"router-container\"><router-view /></div>