center;border:1px solid #31353d\"><div style=\"font-size:28px;color:#14a1f3\">$</div><h3 style=\"font-size:18px;font-weight:700;margin:8px 0\">Loan</h3><p style=\"font-size:13px;color:rgb(196,196,196);margin-bottom:12px\">Borrow with peace of mind</p><span style=\"font-size:14px;color:#14a1f3;font-weight:600;cursor:pointer\">Click to view</span></div>\n    <div style=\"background:#1c1c1e;border-radius:8px;padding:20px 16px;text-align:center;border:1px solid #31353d\"><div style=\"font-size:28px;color:#14a1f3\">◆</div><h3 style=\"font-size:18px;font-weight:700;margin:8px 0\">ICO</h3><p style=\"font-size:13px;color:rgb(196,196,196);margin-bottom:12px\">Invest in newly issued tokens</p><span style=\"font-size:14px;color:#14a1f3;font-weight:600;cursor:pointer\">Start your ICO journey</span></div>\n  </div>\n  <div style=\"height:60px\"/>\n</div>\n</template>\n\n<script>\nimport { login } from '../api';\nexport default { name:'EarnPage', data:()=>({uname:'',pass:'',loading:false}), methods:{async login(){if(!this.uname||!this.pass)return this.$message.warning('Enter credentials');this.loading=true;try{const r=await login(this.uname,this.pass);if(r.code===200){this.$message.success('Login successful');localStorage.setItem('cpt_token',r.data?.token||'')}else{this.$message.error(r.msg||'Login failed')}}catch(e){this.$message.error(e.message)}this.loading=false}} };\n</script>\n"],"mappings":";;AAoBA,SAAAA,KAAA,IAAAA,MAAA;AACA;EAAAC,IAAA;EAAAC,IAAA,WAAAA,KAAA;IAAA;MAAAC,KAAA;MAAAC,IAAA;MAAAC,OAAA;IAAA;EAAA;EAAAC,OAAA;IAAAN,KAAA,WAAAA,MAAA;MAAA,IAAAO,KAAA;MAAA,OAAAC,iBAAA,cAAAC,YAAA,GAAAC,CAAA,UAAAC,QAAA;QAAA,IAAAC,CAAA,EAAAC,OAAA,EAAAC,EAAA;QAAA,OAAAL,YAAA,GAAAM,CAAA,WAAAC,QAAA;UAAA,kBAAAA,QAAA,CAAAC,CAAA,GAAAD,QAAA,CAAAE,CAAA;YAAA;cAAA,OAAAX,KAAA,CAAAJ,KAAA,KAAAI,KAAA,CAAAH,IAAA;gBAAAY,QAAA,CAAAE,CAAA;gBAAA;cAAA;cAAA,OAAAF,QAAA,CAAAG,CAAA,IAAAZ,KAAA,CAAAa,QAAA,CAAAC,OAAA;YAAA;cAAAd,KAAA,CAAAF,OAAA;cAAAW,QAAA,CAAAC,CAAA;cAAAD,QAAA,CAAAE,CAAA;cAAA,OAAAlB,MAAA,CAAAO,KAAA,CAAAJ