;\n      this.withdrawVisible = true;\n    },\n    doWithdraw: function doWithdraw() {\n      var _this = this;\n      if (!this.withdrawAddress || !this.withdrawAmount) {\n        this.$message.warning('请填写完整信息');\n        return;\n      }\n      var item = this.balances.find(function (b) {\n        return b.coin === _this.withdrawCoin;\n      });\n      if (item && parseFloat(this.withdrawAmount) > item.balance) {\n        this.$message.error('余额不足');\n        return;\n      }\n      item.balance -= parseFloat(this.withdrawAmount);\n      item.usdtValue = item.balance * item.price;\n      this.withdrawVisible = false;\n      this.$message.success('提现成功');\n    }\n  },\n  created: function created() {\n    this.initBalances();\n  },\n  mounted: function mounted() {\n    var _this2 = this;\n    this.$nextTick(function () {\n      return _this2.renderChart();\n    });\n  }\n};","map":{"version":3,"names":["coinIcon","coinIconUrl","fmtPrice","echarts","require","e","name","data","loading","balances","depositVisible","depositCoin","depositAddress","withdrawVisible","withdrawCoin","withdrawAddress","withdrawAmount","computed","totalValue","reduce","sum","b","usdtValue","methods","renderChart","$refs","assetChart","length","chart","init","map","coin","value","setOption","tooltip","trigger","formatter","series","type","radius","center","filter","d","label","itemStyle","borderRadius","initBalances","coins","prices","BTC","ETH","BNB","SOL","XRP","DOGE","ADA","AVAX","USDT","c","balance","price","icon","showDeposit","item","Array","from","Math","floor","random","toString","join","copyAddress","_navigator$clipboard","navigator","clipboard","writeText","$message","success","showWithdraw","doWithdraw","_this","warning","find","parseFloat","error","created","mounted","_this2","$nextTick"],"sources":["src/views/Assets.vue"],"sourcesContent":["<template>\n  <div class=\"assets-page page-container\">\n    <header class=\"page-header\">\n      <h2>资产</h2>\n    </header>\n\n    <!-- 总资产 -->\n    <div class=\"total-card card\">\n      <span class=\"total-label\">总资产估值 (USDT)</span>\n      <span class=\"total-value\">${{ fmtPrice(totalValue) }}</span>\n    </div>\n\n    <!-- 资产曲线 -->\n    <div ref=\"assetChart\" class=\"asset-chart\"></div>\n\n    <!-- 币种余额列表 -->\n    <div class=\"asset-list\">\n      <div v-for=\"item in balances\" :key=\"item.coin\" class=\"asset-row card\">\n        <div class=\"asset-left\">\n          <img :src=\"item.icon\" :alt=\"item.coin\" class=\"asset-icon\" @error=\"e => e.target.style.display='none'\" />\n          <div class=\"asset-info\">\n            <span class=\"asset-coin\">{{ item.coin }}</span>\n            <span class=\"asset-fullname\">{{ item.coin }} Wallet</span>\n          </div>\n        </div>\n        <div class=\"asset-right\">\n          <div class=\"asset-balance\">\n            <span class=\"balance-amount\">{{ item.balance }}</span>\n            <span class=\"balance-value\">≈ ${{ fmtPrice(item.usdtValue) }}</span>\n          </div>\n        </div>\n        <div class=\"asset-actions\">\n          <el-button size=\"mini\" type=\"primary\" plain @click=\"showDeposit(item)\">充值</el-button>\n          <el-button size=\"mini\" plain @click=\"showWithdraw(item)\">提现</el-button>\n        </div>\n      </div>\n    </div>\n\n    <!-- 骨架屏 -->\n    <div v-if=\"loading\" class=\"asset-list\">\n      <div v-for=\"i in 5\" :key=\"i\" class=\"asset-row card\">\n        <div class=\"skeleton\" style=\"height: 40px; width: 100%\" />\n      </div>\n    </div>\n\n    <!-- 充值弹窗 -->\n    <el-dialog :title=\"'充值 ' + depositCoin\" :visible.sync=\"depositVisible\" width=\"360px\">\n      <div class=\"deposit-content\">\n        <p>请向以下地址转账 {{ depositCoin }}：</p>\n        <div class=\"address-box\">\n          <code>{{ depositAddress }}</code>\n          <el-button size=\"mini\" type=\"primary\" @click=\"copyAddress\">复制</el-button>\n        </div>\n      </div>\n    </el-dialog>\n\n    <!-- 提现弹窗 -->\n    <el-dialog :title=\"'提现 ' + withdrawCoin\" :visible.sync=\"withdrawVisible\" width=\"360px\">\n      <div class=\"withdraw-form\">\n        <el-input v-model=\"withdrawAddress\" placeholder=\"提现地址\" size=\"small\" />\n        <el-input v-model=\"withdrawAmount\" placeholder=\"数量\" size=\"small\" type=\"number\" style=\"margin-top:12px\" />\n        <el-button type=\"primary\" style=\"margin-top:16px;width:100%\" @click=\"doWithdraw\">确认提现</el-button>\n      </div>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport { coinIcon as coinIconUrl } from '../api';\nimport { fmtPrice } from '../utils/price';\nlet echarts = null; try { echarts = require('echarts'); } catch(e) {}\n\nexport default {\n  name: 'AssetsPage',\n  \n  data() {\n    return {\n      loading: false,\n      balances: [],\n      depositVisible: false,\n      depositCoin: '',\n      depositAddress: '',\n      withdrawVisible: false,\n      withdrawCoin: '',\n      withdrawAddress: '',\n      withdrawAmount: ''\n    };\n  },\n  \n  computed: {\n    totalValue() {\n      return this.balances.reduce((sum, b) => sum + (b.usdtValue || 0), 0);\n    }\n  },\n  \n  methods: {\n    fmtPrice,\n    \n    renderChart() {\n      if (!echarts || !this.$refs.assetChart || this.balances.length === 0) return;\n      if (!this.chart) this.chart = echarts.init(this.$refs.assetChart);\n      const data = this.balances.map(b => ({ name: b.coin, value: b.usdtValue || 0 }));\n      this.chart.setOption({\n        tooltip: { trigger: 'item', formatter: '{b}: ${c}' },\n        series: [{\n          type: 'pie', radius: ['50%', '75%'], center: ['50%', '50%'],\n          data: data.filter(d => d.value > 0),\n          label: { formatter: '{b}\\n{d}%' },\n          itemStyle: { borderRadius: 4 }\n        }]\n      }, true);\n    },\n    \n    initBalances() {\n      const coins = ['BTC','ETH','BNB','SOL','XRP','DOGE','ADA','AVAX','USDT'];\n      const prices = { BTC: 79300, ETH: 2250, BNB: 668, SOL: 91, XRP: 1.42, DOGE: 0.11, ADA: 0.26, AVAX: 9.7, USDT: 1 };\n      const balances = { BTC: 1.5, ETH: 10, BNB: 50, SOL: 200, XRP: 10000, DOGE: 50000, ADA: 30000, AVAX: 500, USDT: 100000 };\n      \n      this.balances = coins.map(c => ({\n        coin: c,\n        balance: balances[c] || 0,\n        price: prices[c] || 0,\n        usdtValue: (balances[c] || 0) * (prices[c] || 0),\n        icon: coinIconUrl(c)\n      }));\n    },\n    \n    showDeposit(item) {\n      this.depositCoin = item.coin;\n      this.depositAddress = '0x' + Array.from({length:40}, () => Math.floor(Math.random()*16).toString(16)).join('');\n      this.depositVisible = true;\n    },\n    \n    copyAddress() {\n      navigator.clipboard?.writeText(this.depositAddress);\n      this.$message.success('地址已复制');\n    },\n    \n    showWithdraw(item) {\n      this.withdrawCoin = item.coin;\n      this.withdrawAddress = '';\n      this.withdrawAmount = '';\n      this.withdrawVisible = true;\n    },\n    \n    doWithdraw() {\n      if (!this.withdrawAddress || !this.withdrawAmount) {\n        this.$message.warning('请填写完整信息');\n        return;\n      }\n      const item = this.balances.find(b => b.coin === this.withdrawCoin);\n      if (item && parseFloat(this.withdrawAmount) > item.balance) {\n        this.$message.error('余额不足');\n        return;\n      }\n      item.balance -= parseFloat(this.withdrawAmount);\n      item.usdtValue = item.balance * item.price;\n      this.withdrawVisible = false;\n      this.$message.success('提现成功');\n    }\n  },\n  \n  created() {\n    this.initBalances();\n  },\n  mounted() {\n    this.$nextTick(() => this.renderChart());\n  }\n};\n</script>\n\n<style lang=\"scss\" scoped>\n.total-card {\n  display: flex; flex-direction: column; gap: var(--sp-sm);\n  margin-bottom: var(--sp-lg);\n  .total-label { font-size: var(--fs-sm); color: var(--text-3); }\n  .total-value { font-size: var(--fs-xxl); font-weight: 700; color: var(--up); }\n}\n\n.asset-list { display: flex; flex-direction: column; gap: var(--sp-md); }\n\n.asset-row {\n  display: flex; align-items: center; gap: var(--sp-md); flex-wrap: wrap;\n  \n  .asset-left {\n    display: flex; align-items: center; gap: var(--sp-sm); flex: 1; min-width: 150px;\n    .asset-icon { width: 32px; height: 32px; border-radius: 50%; }\n    .asset-coin { font-weight: 700; }\n    .asset-fullname { display: block; font-size: var(--fs-xs); color: var(--text-3); }\n  }\n  \n  .asset-right {\n    text-align: right; min-width: 120px;\n    .balance-amount { display: block; font-weight: 600; }\n    .balance-value { font-size: var(--fs-xs); color: var(--text-3); }\n  }\n  \n  .asset-actions { display: flex; gap: var(--sp-sm); }\n}\n\n.address-box {\n  background: var(--bg); padding: var(--sp-md); border-radius: var(--radius-md);\n  word-break: break-all; margin-top: var(--sp-md);\n  code { font-size: var(--fs-xs); }\n  .el-button { margin-top: var(--sp-sm); }\n}\n\n@media (max-width: 480px) {\n  .asset-row { flex-direction: column; align-items: flex-start; }\n  .asset-actions { width: 100%; justify-content: flex-end; }\n}\n</style>\n"],"mappings":";;;;;;;;;;;;;;;;;AAoEA,SAAAA,QAAA,IAAAC,WAAA;AACA,SAAAC,QAAA;AACA,IAAAC,OAAA;AAAA;EAAAA,OAAA,GAAAC,OAAA;AAAA,SAAAC,CAAA;AAEA;EACAC,IAAA;EAEAC,IAAA,WAAAA,KAAA;IACA;MACAC,OAAA;MACAC,QAAA;MACAC,cAAA;MACAC,WAAA;MACAC,cAAA;MACAC,eAAA;MACAC,YAAA;MACAC,eAAA;MACAC,cAAA;IACA;EACA;EAEAC,QAAA;IACAC,UAAA,WAAAA,WAAA;MACA,YAAAT,QAAA,CAAAU,MAAA,WAAAC,GAAA,EAAAC,CAAA;QAAA,OAAAD,GAAA,IAAAC,CAAA,CAAAC,SAAA;MAAA;IACA;EACA;EAEAC,OAAA;IACArB,QAAA,EAAAA,QAAA;IAEAsB,WAAA,WAAAA,YAAA;MACA,KAAArB,OAAA,UAAAsB,KAAA,CAAAC,UAAA,SAAAjB,QAAA,CAAAkB,MAAA;MACA,UAAAC,KAAA,OAAAA,KAAA,GAAAzB,OAAA,CAAA0B,IAAA,MAAAJ,KAAA,CAAAC,UAAA;MACA,IAAAnB,IAAA,QAAAE,QAAA,CAAAqB,GAAA,WAAAT,CAAA;QAAA;UAAAf,IAAA,EAAAe,CAAA,CAAAU,IAAA;UAAAC,KAAA,EAAAX,CAAA,CAAAC,SAAA;QAAA;MAAA;MACA,KAAAM,KAAA,CAAAK,SAAA;QACAC,OAAA;UAAAC,OAAA;UAAAC,SAAA;QAAA;QACAC,MAAA;UACAC,IAAA;UAAAC,MAAA;UAAAC,MAAA;UACAjC,IAAA,EAAAA,IAAA,CAAAkC,MAAA,WAAAC,CAAA;YAAA,OAAAA,CAAA,CAAAV,KAAA