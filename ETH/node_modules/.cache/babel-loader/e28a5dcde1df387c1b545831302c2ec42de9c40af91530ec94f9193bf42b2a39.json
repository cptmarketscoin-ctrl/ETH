: {\n    fmtPrice: fmtPrice,\n    generateOrderBook: function generateOrderBook() {\n      var base = parseFloat(this.currentPrice) || 100;\n      var asks = [],\n        bids = [];\n      for (var i = 1; i <= 8; i++) {\n        asks.push({\n          price: fmtPrice(base * (1 + i * 0.001)),\n          amount: (Math.random() * 2).toFixed(4)\n        });\n        bids.push({\n          price: fmtPrice(base * (1 - i * 0.001)),\n          amount: (Math.random() * 2).toFixed(4)\n        });\n      }\n      this.asks = asks;\n      this.bids = bids;\n    },\n    placeOrder: function placeOrder() {\n      var _this = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee() {\n        return _regenerator().w(function (_context) {\n          while (1) switch (_context.n) {\n            case 0:\n              _this.submitting = true;\n              setTimeout(function () {\n                _this.submitting = false;\n                _this.orders.unshift({\n                  id: Date.now(),\n                  side: _this.side,\n                  price: _this.orderPrice || _this.currentPrice,\n                  amount: _this.orderAmount,\n                  total: fmtPrice(_this.orderTotal),\n                  status: '成交'\n                });\n                _this.$message.success(\"\".concat(_this.side === 'buy' ? '买入' : '卖出', \"\\u6210\\u529F\"));\n              }, 800);\n            case 1:\n              return _context.a(2);\n          }\n        }, _callee);\n      }))();\n    },\n    cancelOrder: function cancelOrder(id) {\n      this.orders = this.orders.filter(function (o) {\n        return o.id !== id;\n      });\n      this.$message.info('已撤单');\n    },\n    onWsMessage: function onWsMessage(msg) {\n      if (msg.type === '1004') {\n        var symbol = msg.symbol;\n        if (symbol === this.activePair) {\n          var data = msg.optionMakerResponse || {};\n          this.currentPrice = data.lastPrice || this.currentPrice;\n          this.generateOrderBook();\n        }\n      }\n    }\n  },\n  created: function created() {\n    var _this2 = this;\n    pageHome().then(function (res) {\n      if (res.code === 200) {\n        var coins = res.content || [];\n        var current = coins.find(function (c) {\n          return c.fromSymbol + 'USDT' === _this2.activePair;\n        });\n        if (current) _this2.currentPrice = current.lastPrice || '0.00';\n      }\n    });\n    this.generateOrderBook();\n  },\n  mounted: function mounted() {\n    connect(this.onWsMessage);\n  }\n};","map":{"version":3,"names":["pageHome","coinIcon","cnIcon","connect","fmtPrice","name","data","activePair","pairs","side","orderType","orderPrice","orderAmount","submitting","currentPrice","asks","bids","orders","computed","coin","replace","orderTotal","parseFloat","watch","generateOrderBook","methods","base","i","push","price","amount","Math","random","toFixed","placeOrder","_this","_asyncToGenerator","_regenerator","m","_callee","w","_context","n","setTimeout","unshift","id","Date","now","total","status","$message","success","concat","a","cancelOrder","filter","o","info","onWsMessage","msg","type","symbol","optionMakerResponse","lastPrice","created","_this2","then","res","code","coins","content","current","find","c","fromSymbol","mounted"],"sources":["src/views/Trade.vue"],"sourcesContent":["<template>\n  <div class=\"trade-page\">\n    <!-- 交易对选择 -->\n    <header class=\"trade-header\">\n      <el-select v-model=\"activePair\" placeholder=\"选择交易对\" size=\"small\" class=\"pair-select\">\n        <el-option \n          v-for=\"p in pairs\" :key=\"p\" :label=\"p\" :value=\"p\"\n        />\n      </el-select>\n      <span class=\"trade-price\">\n        <span class=\"price-text lg text-up\">{{ currentPrice }}</span>\n      </span>\n    </header>\n\n    <!-- K线图区域（占位） -->\n    <div class=\"kline-area\">\n      <div class=\"kline-placeholder\">\n        <i class=\"el-icon-data-line\" style=\"font-size:48px;color:var(--text-4)\" />\n        <p>K线图区域 — 可接 TradingView</p>\n      </div>\n    </div>\n\n    <!-- 下单面板 -->\n    <div class=\"trade-panel\">\n      <div class=\"panel-tabs\">\n        <span :class=\"{ active: side === 'buy' }\" @click=\"side = 'buy'\">买入</span>\n        <span :class=\"{ active: side === 'sell' }\" @click=\"side = 'sell'\">卖出</span>\n      </div>\n      \n      <div class=\"panel-form\">\n        <div class=\"form-row\">\n          <label>类型</label>\n          <el-radio-group v-model=\"orderType\" size=\"small\">\n            <el-radio-button label=\"limit\">限价</el-radio-button>\n            <el-radio-button label=\"market\">市价</el-radio-button>\n          </el-radio-group>\n        </div>\n        \n        <div class=\"form-row\" v-if=\"orderType === 'limit'\">\n          <label>价格 (USDT)</label>\n          <el-input-number \n            v-model=\"orderPrice\" \n            :precision=\"2\" :min=\"0\"\n            size=\"small\"\n            controls-position=\"right\"\n          />\n        </div>\n        \n        <div class=\"form-row\">\n          <label>数量 ({{ coin }})</label>\n          <el-input-number \n            v-model=\"orderAmount\" \n            :precision=\"4\" :min=\"0\"\n            size=\"small\"\n            controls-position=\"right\"\n          />\n        </div>\n        \n        <div class=\"form-row\">\n          <label>总额</label>\n          <span class=\"form-value\">{{ fmtPrice(orderTotal) }} USDT</span>\n        </div>\n        \n        <el-button \n          :type=\"side === 'buy' ? 'success' : 'danger'\"\n          class=\"submit-btn\"\n          :class=\"side === 'buy' ? 'btn-up' : 'btn-down'\"\n          @click=\"placeOrder\"\n          :loading=\"submitting\"\n        >\n          {{ side === 'buy' ? '买入' : '卖出' }} {{ coin }}\n        </el-button>\n      </div>\n    </div>\n\n    <!-- 订单簿（模拟） -->\n    <div class=\"orderbook\">\n      <h4>订单簿</h4>\n      <div class=\"book-columns\">\n        <div class=\"book-side asks\">\n          <div v-for=\"(row, i) in asks\" :key=\"'a'+i\" class=\"book-row\">\n            <span class=\"price text-down\">{{ row.price }}</span>\n            <span class=\"amount\">{{ row.amount }}</span>\n          </div>\n        </div>\n        <div class=\"book-center\">\n          <span class=\"book-spread text-up\">{{ currentPrice }}</span>\n        </div>\n        <div class=\"book-side bids\">\n          <div v-for=\"(row, i) in bids\" :key=\"'b'+i\" class=\"book-row\">\n            <span class=\"price text-up\">{{ row.price }}</span>\n            <span class=\"amount\">{{ row.amount }}</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- 当前委托 -->\n    <div class=\"orders-section\">\n      <h4>当前委托</h4>\n      <el-table :data=\"orders\" size=\"small\" empty-text=\"暂无委托\">\n        <el-table-column prop=\"side\" label=\"方向\" width=\"60\">\n          <template #default=\"{ row }\">\n            <span :class=\"row.side === 'buy' ? 'text-up' : 'text-down'\">\n              {{ row.side === 'buy' ? '买' : '卖' }}\n            </span>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"price\" label=\"价格\" />\n        <el-table-column prop=\"amount\" label=\"数量\" />\n        <el-table-column prop=\"total\" label=\"总额\" />\n        <el-table-column prop=\"status\" label=\"状态\" />\n        <el-table-column label=\"操作\" width=\"60\">\n          <template #default=\"{ row }\">\n            <el-button type=\"text\" size=\"mini\" @click=\"cancelOrder(row.id)\">撤单</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { pageHome, coinIcon as cnIcon } from '../api';\nimport { connect } from '../api/ws';\nimport { fmtPrice } from '../utils/price';\n\nexport default {\n  name: 'TradePage',\n  \n  data() {\n    return {\n      activePair: 'BTCUSDT',\n      pairs: ['BTCUSDT','ETHUSDT','BNBUSDT','SOLUSDT','XRPUSDT','DOGEUSDT','ADAUSDT','AVAXUSDT'],\n      side: 'buy',\n      orderType: 'limit',\n      orderPrice: 0,\n      orderAmount: 0,\n      submitting: false,\n      currentPrice: '0.00',\n      asks: [],\n      bids: [],\n      orders: []\n    };\n  },\n  \n  computed: {\n    coin() { return this.activePair.replace('USDT', ''); },\n    orderTotal() {\n      return this.orderType === 'market' \n        ? this.orderAmount * parseFloat(this.currentPrice || 0)\n        : this.orderAmount * this.orderPrice;\n    }\n  },\n  \n  watch: {\n    activePair() { this.generateOrderBook(); }\n  },\n  \n  methods: {\n    fmtPrice,\n    \n    generateOrderBook() {\n      const base = parseFloat(this.currentPrice) || 100;\n      const asks = [], bids = [];\n      for (let i = 1; i <= 8; i++) {\n        asks.push({ price: fmtPrice(base * (1 + i * 0.001)), amount: (Math.random() * 2).toFixed(4) });\n        bids.push({ price: fmtPrice(base * (1 - i * 0.001)), amount: (Math.random() * 2).toFixed(4) });\n      }\n      this.asks = asks;\n      this.bids = bids;\n    },\n    \n    async placeOrder() {\n      this.submitting = true;\n      setTimeout(() => {\n        this.submitting = false;\n        this.orders.unshift({\n          id: Date.now(),\n          side: this.side,\n          price: this.orderPrice || this.currentPrice,\n          amount: this.orderAmount,\n          total: fmtPrice(this.orderTotal),\n          status: '成交'\n        });\n        this.$message.success(`${this.side === 'buy' ? '买入' : '卖出'}成功`);\n      }, 800);\n    },\n    \n    cancelOrder(id) {\n      this.orders = this.orders.filter(o => o.id !== id);\n      this.$message.info('已撤单');\n    },\n    \n    onWsMessage(msg) {\n      if (msg.type === '1004') {\n        const symbol = msg.symbol;\n        if (symbol === this.activePair) {\n          const data = msg.optionMakerResponse || {};\n          this.currentPrice = data.lastPrice || this.currentPrice;\n          this.generateOrderBook();\n        }\n      }\n    }\n  },\n  \n  created() {\n    pageHome().then(res => {\n      if (res.code === 200) {\n        const coins = res.content || [];\n        const current = coins.find(c => (c.fromSymbol + 'USDT') === this.activePair);\n        if (current) this.currentPrice = current.lastPrice || '0.00';\n      }\n    });\n    this.generateOrderBook();\n  },\n  \n  mounted() { connect(this.onWsMessage); }\n};\n</script>\n\n<style lang=\"scss\" scoped>\n.trade-page { padding: var(--sp-md); max-width: 800px; margin: 0 auto; }\n\n.trade-header {\n  display: flex; align-items: center; gap: var(--sp-lg); margin-bottom: var(--sp-md);\n  .pair-select { width: 140px; }\n}\n\n.kline-area {\n  height: 300px; background: var(--bg-white); border-radius: var(--radius-lg);\n  margin-bottom: var(--sp-md);\n  .kline-placeholder {\n    display: flex; flex-direction: column; align-items: center; justify-content: center;\n    height: 100%; color: var(--text-3); gap: var(--sp-sm);\n  }\n}\n\n.trade-panel {\n  background: var(--bg-white); border-radius: var(--radius-lg); padding: var(--sp-lg);\n  margin-bottom: var(--sp-md);\n  .panel-tabs {\n    display: flex; margin-bottom: var(--sp-lg);\n    span { flex: 1; text-align: center; padding: var(--sp-sm); cursor: pointer; border-radius: var(--radius-md); }\n    span.active { font-weight: 700; }\n    span:first-child.active { background: var(--up-light); color: var(--up); }\n    span:last-child.active { background: var(--down-light); color: var(--down); }\n  }\n  .form-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--sp-md); label { color: var(--text-2); } }\n  .submit-btn { width: 100%; margin-top: var(--sp-md); }\n}\n\n.orderbook {\n  background: var(--bg-white); border-radius: var(--radius-lg); padding: var(--sp-lg);\n  margin-bottom: var(--sp-md);\n  h4 { margin-bottom: var(--sp-md); }\n  .book-columns { display: flex; }\n  .book-side { flex: 1; }\n  .book-center { display: flex; align-items: center; padding: 0 var(--sp-md); font-size: var(--fs-lg); font-weight: 700; }\n  .book-row { display: flex; justify-content: space-between; padding: 2px 0; font-size: var(--fs-sm); .price { font-family: var(--font-mono); } .amount { color: var(--text-3); } }\n}\n\n.orders-section { background: var(--bg-white); border-radius: var(--radius-lg); padding: var(--sp-lg); }\n</style>\n"],"mappings":";;;;;;;;;;;;;;;;AA2HA,SAAAA,QAAA,EAAAC,QAAA,IAAAC,MAAA;AACA,SAAAC,OAAA;AACA,SAAAC,QAAA;AAEA;EACAC,IAAA;EAEAC,IAAA,WAAAA,KAAA;IACA;MACAC,UAAA;MACAC,KAAA;MACAC,IAAA;MACAC,SAAA;MACAC,UAAA;MACAC,WAAA;MACAC,UAAA;MACAC,YAAA;MACAC,IAAA;MACAC,IAAA;MACAC,MAAA;IACA;EACA;EAEAC,QAAA;IACAC,IAAA,WAAAA,KAAA;MAAA,YAAAZ,UAAA,CAAAa,OAAA;IAAA;IACAC,UAAA,WAAAA,WAAA;MACA,YAAAX,SAAA,gBACA,KAAAE,WAAA,GAAAU,UAAA,MAAAR,YAAA,SACA,KAAAF,WAAA,QAAAD,UAAA;IACA;EACA;EAEAY,KAAA;IACAhB,UAAA,WAAAA,WAAA;MAAA,KAAAiB,iBAAA;IAAA;EACA;EAEAC,OAAA;IACArB,QAAA,EAAAA,QAAA;IAEAoB,iBAAA,WAAAA,kBAAA;MACA,IAAAE,IAAA,GAAAJ,UAAA,MAAAR,YAAA;MACA,IAAAC,IAAA;QAAAC,IAAA;MACA,SAAAW,CAAA,MAAAA,CAAA,OAAAA,CAAA;QACAZ,IAAA,CAAAa,IAAA;UAAAC,KAAA,EAAAzB,QAAA,CAAAsB,IAAA,QAAAC,CAAA;UAAAG,MAAA,GAAAC,IAAA,CAAAC,MAAA,QAAAC,OAAA;QAAA;QACAjB,IAAA,CAAAY,IAAA;UAAAC,KAAA,EAAAzB,QAAA,CAAAsB,IAAA,QAAAC,CAAA;UAAAG,MAAA,GAAAC,IAAA,CAAAC,MAAA,QAAAC,OAAA;QAAA;MACA;MACA,KAAAlB,IAAA,GAAAA,IAAA;MACA,KAAAC,IAAA,GAAAA,IAAA;IACA;IAEAkB,UAAA,WAAAA,WAAA;MAAA,IAAAC,KAAA;MAAA,OAAAC,iBAAA,cAAAC,YAAA,GAAAC,CAAA,UAAAC,QAAA;QAAA,OAAAF,YAAA,GAAAG,CAAA,WAAAC,QAAA;UAAA,kBAAAA,QAAA,CAAAC,CAAA;YAAA;cACAP,KAAA,CAAAtB,UAAA;cACA8B,UAAA;gBACAR,KAAA,CAAAtB,UAAA;gBACAsB,KAAA,CAAAlB,MAAA,CAAA2B,OAAA;kBACAC,EAAA,EAAAC,IAAA,CAAAC,GAAA;kBACAtC,IAAA,EAAA0B,KAAA,CAAA1B,IAAA;kBACAoB,KAAA,EAAAM,KAAA,CAAAxB,UAAA,IAAAwB,KAAA,CAAArB,YAAA;kBACAgB,MAAA,EAAAK,KAAA,CAAAvB,WAAA;kBACAoC,KAAA,EAAA5C,QAAA,CAAA+B,KAAA,CAAAd,UAAA;kBACA4B,MAAA;gBACA;gBACAd,KAAA,CAAAe,QAAA,CAAAC,OAAA,IAAAC,MAAA,CAAAjB,KAAA,CAAA1B,IAAA;cACA;YAAA;cAAA,OAAAgC,QAAA,CAAAY,CAAA;UAAA;QAAA,GAAAd,OAAA;MAAA;IACA;IAEAe,WAAA,WAAAA,YAAAT,EAAA;MACA,KAAA5B,MAAA,QAAAA,MAAA,CAAAsC